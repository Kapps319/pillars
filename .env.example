# ------------------------------------------------------------------------
# AI Intent Lead Finder — environment configuration
# Copy to .env:   cp .env.example .env
# EVERYTHING here is optional for the demo: `docker compose up` works keyless
# (mock source + rules classifier). Missing key => that feature is logged and
# skipped, never a crash.
# ------------------------------------------------------------------------

# --- Core ---
# Postgres connection string (compose overrides this for the containers)
DATABASE_URL=postgresql+psycopg://leadfinder:leadfinder@localhost:5432/leadfinder
# Redis broker/result backend for Celery
REDIS_URL=redis://localhost:6379/0
# Signs JWTs and derives the encryption key for stored integration secrets.
# CHANGE THIS IN PRODUCTION. Rotating it invalidates stored integration keys.
SECRET_KEY=dev-secret-change-me-in-production

# --- LLM classifier ---
# rules  = keyless keyword/regex classifier (default; always works)
# claude = Anthropic API (needs ANTHROPIC_API_KEY)
# openai = OpenAI API   (needs OPENAI_API_KEY)
LLM_PROVIDER=rules
# ANTHROPIC_API_KEY=            # Claude classifier (console.anthropic.com)
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_API_KEY=               # alt classifier (platform.openai.com)
# OPENAI_MODEL=gpt-4o-mini

# --- Data sources ---
# Comma-separated adapter keys to enable. Available: mock, reddit, google,
# manual_url, twitter (twitter also needs TWITTER_BEARER and is paid).
SOURCES_ENABLED=mock,reddit,google,manual_url
# Reddit source: create a 'script' app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=leadfinder/0.1 by your-reddit-username
# Google web search: Custom Search JSON API (100 free queries/day)
# key: https://console.cloud.google.com  ·  engine: https://programmablesearchengine.google.com
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
# X/Twitter: paid API v2 bearer token — adapter ships DISABLED by default;
# add "twitter" to SOURCES_ENABLED to activate.
# TWITTER_BEARER=

# --- Search backend ---
# postgres (default, uses Postgres full-text search) | elasticsearch
# (placeholder flag: logs a warning and falls back to postgres for now)
SEARCH_BACKEND=postgres

# --- Background jobs ---
# true = run scraping jobs on the Celery worker via Redis.
# If the broker is unreachable (or false), jobs run in-process automatically.
CELERY_ENABLED=true

# --- Bootstrapping / misc ---
# Seed demo user (demo@leadfinder.app / demo12345), campaign and sample leads
SEED_ON_STARTUP=true
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# Where the browser reaches the API (baked into the frontend build)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
